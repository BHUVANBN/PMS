# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/PMS?retryWrites=true&w=majority

# Auth - use a strong 64+ char random string for production
JWT_SECRET=replace_with_a_strong_64_char_random_secret

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMTP (e.g. Gmail)
SMTP_FROM=noreply@yourcompany.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Frontend URL (for CORS and password reset links)
FRONTEND_URL=http://localhost:5174
